#!/usr/bin/env php
<?php declare(strict_types=1);

namespace thephpcc\academy;

use ArgumentCountError;
use ReflectionClass;
use thephpcc\academy\credits\AcquireCreditsCommand;
use thephpcc\academy\credits\CreateCreditsAccountCommand;
use thephpcc\academy\credits\ExpireCreditsCommand;
use thephpcc\academy\credits\GrantCreditCommand;
use thephpcc\academy\credits\GrantCreditsDashboardAccessTokenCommand;
use thephpcc\academy\execution\BookAmaSessionCommand;
use thephpcc\academy\execution\BookSmycSessionCommand;
use thephpcc\academy\execution\BookTrainingCommand;
use thephpcc\academy\execution\CancelTrainingCommand;
use thephpcc\academy\execution\DeclareFreeForAllCommand;
use thephpcc\academy\execution\EnrollFlatrateGuestCommand;
use thephpcc\academy\execution\EnrollFlatrateParticipantCommand;
use thephpcc\academy\execution\EnrollParticipantCommand;
use thephpcc\academy\execution\PrepareEMailToParticipantsCommand;
use thephpcc\academy\execution\PriceTrainingCommand;
use thephpcc\academy\execution\ReconfirmEnrollmentCommand;
use thephpcc\academy\execution\RequestFeedbackCommand;
use thephpcc\academy\execution\RescheduleSessionCommand;
use thephpcc\academy\execution\ScheduleSessionCommand;
use thephpcc\academy\execution\ScheduleTrainingCommand;
use thephpcc\academy\execution\SetMeetingUrlCommand;
use thephpcc\academy\execution\RemoveParticipantCommand;
use thephpcc\academy\flatrate\ActivateAskMeAnythingAndShowMeYourCodeCommand;
use thephpcc\academy\flatrate\ActivateBookingOfEnglishTrainingCommand;
use thephpcc\academy\flatrate\ActivateBookingOfGermanTrainingCommand;
use thephpcc\academy\flatrate\BookFlatrateSeatCommand;
use thephpcc\academy\flatrate\CancelFlatrateSeatCommand;
use thephpcc\academy\flatrate\CreateFlatrateAccountCommand;
use thephpcc\academy\flatrate\DeactivateAskMeAnythingAndShowMeYourCodeCommand;
use thephpcc\academy\flatrate\DeactivateBookingOfEnglishTrainingCommand;
use thephpcc\academy\flatrate\DeactivateBookingOfGermanTrainingCommand;
use thephpcc\academy\flatrate\GrantFlatrateDashboardAccessTokenCommand;

require __DIR__ . '/../vendor/autoload.php';

$commandMap = [
    'create-flatrate-account' => CreateFlatrateAccountCommand::class,
    'grant-flatrate-dashboard-access-token' => GrantFlatrateDashboardAccessTokenCommand::class,
    'book-flatrate-seat' => BookFlatrateSeatCommand::class,
    'activate-booking-of-german-training' => ActivateBookingOfGermanTrainingCommand::class,
    'activate-booking-of-english-training' => ActivateBookingOfEnglishTrainingCommand::class,
    'activate-ama-and-smyc' => ActivateAskMeAnythingAndShowMeYourCodeCommand::class,
    'cancel-flatrate-seat' => CancelFlatrateSeatCommand::class,
    'deactivate-booking-of-german-training' => DeactivateBookingOfGermanTrainingCommand::class,
    'deactivate-booking-of-english-training' => DeactivateBookingOfEnglishTrainingCommand::class,
    'deactivate-ama-and-smyc' => DeactivateAskMeAnythingAndShowMeYourCodeCommand::class,
    'enroll-flatrate-participant' => EnrollFlatrateParticipantCommand::class,
    'enroll-flatrate-guest' => EnrollFlatrateGuestCommand::class,
    '',
    'book-ama-session' => BookAmaSessionCommand::class,
    'book-smyc-session' => BookSmycSessionCommand::class,
    '',
    'create-credits-account' => CreateCreditsAccountCommand::class,
    'grant-credits-dashboard-access-token' => GrantCreditsDashboardAccessTokenCommand::class,
    'acquire-credits' => AcquireCreditsCommand::class,
    'grant-credit' => GrantCreditCommand::class,
    'expire-credits' => ExpireCreditsCommand::class,
    '',
    'book-training' => BookTrainingCommand::class,
    'enroll-participant' => EnrollParticipantCommand::class,
    'remove-participant' => RemoveParticipantCommand::class,
    '',
    'schedule-training' => ScheduleTrainingCommand::class,
    'cancel-training' => CancelTrainingCommand::class,
    'price-training' => PriceTrainingCommand::class,
    'declare-free-for-all' => DeclareFreeForAllCommand::class,
    'schedule-session' => ScheduleSessionCommand::class,
    'reschedule-session' => RescheduleSessionCommand::class,
    'set-meeting-url' => SetMeetingUrlCommand::class,
    'reconfirm-enrollment' => ReconfirmEnrollmentCommand::class,
    'request-feedback' => RequestFeedbackCommand::class,
    'prepare-email-to-participants' => PrepareEMailToParticipantsCommand::class
];

if (!isset($argv[1])) {
    showHelp($commandMap);
}

if (!isset($commandMap[$argv[1]])) {
    showHelp($commandMap);
}

$command = $commandMap[$argv[1]];

$arguments = array_slice($argv, 2);

$typedArguments = [];
$types = typesOfConstructorArguments($command);
$count = 0;

foreach ($arguments as $argument) {
    $typedArguments[] = match($types[$count]) {
        'string' => $argument,
        'int' => (int) $argument,
        'float' => (float) $argument,
        'bool' => (bool) $argument,
        default => $argument
    };

    $count++;
}

try {
    $event = Application::run(new $command(...$typedArguments));

    print $event->topic() . ': ' . $event->correlationId()->asString() . PHP_EOL;
    exit(0);
}

catch (ArgumentCountError) {
    printf('Usage: %s ', $argv[1]);
    displayConstructorArguments($command);
    exit(1);
}

catch (Exception $exception) {
    print $exception->getMessage() . PHP_EOL;
    exit(1);
}

function displayConstructorArguments(string $class): void
{
    $reflection = new ReflectionClass($class);
    $constructor = $reflection->getConstructor();
    $parameters = $constructor->getParameters();

    $list = [];

    foreach ($parameters as $parameter) {
        $type = $parameter->getType() ? $parameter->getType()->getName() : 'mixed';
        $name = $parameter->getName();

        if ($parameter->isVariadic()) {
            $list[] = sprintf('(%s) ...$%s', $type, $name) . PHP_EOL;
        } else {
            if ($parameter->isOptional()) {
                $list[] = sprintf('(%s) $%s [ = null ]', $type, $name) . PHP_EOL;
            } else {
                $list[] = sprintf('(%s) $%s', $type, $name) . PHP_EOL;
            }
        }
    }

    if (count($list) > 0) {
        print PHP_EOL . '         ';
    }

    print implode('         ', $list);
    print PHP_EOL;
}

function typesOfConstructorArguments(string $class): array
{
    $reflection = new ReflectionClass($class);
    $constructor = $reflection->getConstructor();
    $parameters = $constructor->getParameters();

    $result = [];

    foreach ($parameters as $parameter) {
        $result[] = $parameter->getType() ? $parameter->getType()->getName() : 'mixed';
    }

    return $result;
}

function showHelp(array $commandMap): never
{
    $map = array_keys($commandMap);

    print 'Available commands:' . PHP_EOL . PHP_EOL;

    foreach ($map as $command) {
        if (is_int($command)) {
            print PHP_EOL;

            continue;
        }

        print '  ' . $command . PHP_EOL;
    }

    exit(1);
}
